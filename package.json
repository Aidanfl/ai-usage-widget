{
  "name": "ai-usage-widget",
  "version": "0.1.1",
  "description": "Desktop widget showing Claude and Codex usage limits side by side",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "author": "Aidan",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.aidan.ai-usage-widget",
    "productName": "AI-Usage-Widget",
    "publish": null,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-portable.${ext}",
      "unpackDirName": "ai-usage-widget"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-win-Setup.${ext}"
    },
    "files": [
      "**/*",
      "!tests/**",
      "!*.md",
      "!dist/**",
      "!src/renderer/preview.html",
      "!src/renderer/mock-api.js",
      "!ARCHITECTURE.md",
      "!.gitignore",
      "!docs/**"
    ]
  }
}
