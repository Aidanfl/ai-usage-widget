<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match the app target exactly: the widget reads the pairing from the shared keychain
	     access group and the cached payload from the shared container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.aidanfl.aiusage</string>
	</array>
</dict>
</plist>
