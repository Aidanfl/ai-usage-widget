# The Xcode project is generated from project.yml by XcodeGen — never commit it.
*.xcodeproj/
*.xcworkspace/

# Info.plist files are generated from the `info:` blocks in project.yml
AIUsage/Info.plist
AIUsageWidget/Info.plist

# Per-user Xcode state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Build output
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager (none used, but keep the tree clean if Xcode adds one)
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store
